# Copy this file to backend/.env and fill in your values.
# Never commit the real .env file: it holds passwords. (.gitignore already skips it.)
# On a hosting site such as Render, enter these same names and values in its
# "Environment" settings instead of uploading a .env file.

# "production" when hosted online, "development" on your own computer
NODE_ENV=development

# Port the server listens on. Hosting sites set this for you, so you can leave it out there.
PORT=8080

# MongoDB connection string.
#   On your computer: mongodb://127.0.0.1:27017/job_portal
#   MongoDB Atlas (free cloud database): mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/job_portal?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/job_portal

# Long random text used to sign logins. Keep it secret and do not change it once the
# site is live (changing it logs everyone out). Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=replace-with-a-long-random-secret

# Admin account created automatically on startup if it does not exist yet.
# Leave both empty to skip. (You can also run: npm run create-admin -- email password)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional settings
# How long a login lasts, in hours
TOKEN_LIFETIME_HOURS=24
# Largest allowed upload (resume / certificate), in MB
MAX_UPLOAD_MB=5
# Folder for uploaded files (default: backend/uploads). On hosts with a persistent
# disk, point this at the disk, e.g. /var/data/uploads
UPLOAD_DIR=
# Other websites allowed to call the API, comma-separated. Not needed normally,
# because this server also serves the pages.
CORS_ORIGINS=

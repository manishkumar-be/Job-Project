# ============================================================================
#  Job Portal settings
#
#  This file is shared on GitHub, so it must only hold safe example values.
#  Put real passwords and secrets in  backend/.env.local  instead (same format).
#  That file stays on your computer: it is never uploaded, and its values
#  replace the ones below.
#
#  On a hosting site (Render, Railway, ...) set the real values in the site's
#  "Environment" settings. Those replace both files.
# ============================================================================

# ---- 1. Choose where the app runs: local  or  online ----------------------
APP_MODE=local

# ---- 2. Database ----------------------------------------------------------
# Used when APP_MODE=local: MongoDB installed on your own computer
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/job_portal

# Used when APP_MODE=online: your MongoDB Atlas connection string.
# It contains a password, so put the real one in .env.local or the host's settings.
MONGO_URI_ONLINE=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/job_portal?retryWrites=true&w=majority

# ---- 3. Login secret ------------------------------------------------------
# Signs logins. This example value is fine on your own computer, but it is
# public, so online the server ignores it. Make your own with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and put it in .env.local or the host's settings.
TOKEN_SECRET=change-me-local-development-secret

# ---- 4. Admin account (created on startup if it does not exist yet) -------
# These example values only work locally. Online, set your own password in
# .env.local or the host's settings (the example password is refused online).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ---- 5. Optional ----------------------------------------------------------
# Port to listen on (hosting sites set this themselves)
PORT=8080
# How long a login lasts, in hours
TOKEN_LIFETIME_HOURS=24
# Largest upload (resume / certificate), in MB
MAX_UPLOAD_MB=5
# Folder for uploaded files; empty = backend/uploads
UPLOAD_DIR=
# Other websites allowed to call the API, comma-separated (normally not needed)
CORS_ORIGINS=

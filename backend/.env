# ============================================================================
#  Job Portal settings
#
#  This file is shared on GitHub, so it must only hold safe example values.
#  Put real passwords and secrets in  backend/.env.local  instead (same format).
#  That file stays on your computer: it is never uploaded, and its values
#  replace the ones below.
#
#  On a hosting site (Render, Railway, ...) set the real values in the site's
#  "Environment" settings. Those replace both files.
# ============================================================================

# ---- 1. Database -----------------------------------------------------------
# The same code works with any MongoDB database; only this line decides which one.
#
#   MongoDB on your own computer (default, works with no setup):
#     MONGO_URI=mongodb://127.0.0.1:27017/job_portal
#
#   One shared online database (MongoDB Atlas) for your computer AND the hosted
#   site, so both show the same users, jobs and applications:
#     put  MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/job_portal?retryWrites=true&w=majority
#     in backend/.env.local (it contains a password) and in the hosting site's settings.
MONGO_URI=mongodb://127.0.0.1:27017/job_portal

# ---- 2. Login secret (this app's "JWT secret") -----------------------------
# Signs the login tokens (the same job a JWT secret does). This example value is fine on your own computer, but it is
# public, so on a hosted site (NODE_ENV=production) the server ignores it. Make your own with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and put it in .env.local or the host's settings.
TOKEN_SECRET=change-me-local-development-secret

# ---- 3. Admin account (created on startup if it does not exist yet) -------
# The example password is public, so it is only used with a database on your
# own computer. With a shared online database, or on a hosted site, set your own
# ADMIN_PASSWORD in .env.local or the host's settings.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ---- 4. Optional ----------------------------------------------------------
# Port to listen on (hosting sites set this themselves)
PORT=8080
# How long a login lasts, in hours
TOKEN_LIFETIME_HOURS=24
# Largest upload (resume / certificate), in MB
MAX_UPLOAD_MB=5
# Folder for uploaded files; empty = backend/uploads
UPLOAD_DIR=
# Other websites allowed to call the API, comma-separated (normally not needed)
CORS_ORIGINS=
